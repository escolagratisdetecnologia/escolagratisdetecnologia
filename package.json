{
  "name": "escolagratisdetecnologia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "turbo run test:e2e",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "content:check": "node packages/content/src/cli.ts content",
    "db:up": "docker compose up -d --wait dynamodb"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
